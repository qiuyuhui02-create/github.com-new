NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback; prefer PUBLISHABLE_KEY above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Only enable after authorizing paid requests. Also requires a signed-in Supabase user.
ENABLE_PAID_AI=false

# Optional canonical login origin; set for Production only. Match Preview origin or leave unset there.
NEXT_PUBLIC_SITE_URL=

# Optional Gemini single-scene revision. All values below are SERVER ONLY.
# Enable only for a Google project verified as Free Tier with NO linked billing.
GEMINI_ENABLED=false
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
# Generate a separate random 64-character access code; never use the Gemini API key here.
GEMINI_ACCESS_CODE=
# Dedicated Upstash Redis FREE database; required for durable, atomic limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
