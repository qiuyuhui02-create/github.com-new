OPENROUTER_MODEL=
OPENROUTER_COMPARE_ENABLED=false
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_COMPARE_ENABLED=false
DOUBAO_TRIAL_CONFIRMED=false
